# Токен от @BotFather
BOT_TOKEN=

# Юзернейм бота без @ (нужен для deep link)
BOT_USERNAME=
ADMIN_IDS=

# SQLite — файл создаётся автоматически в корне проекта, ничего настраивать не нужно
# DB_FILE=quiz_bot.db

# Redis — совпадает с docker-compose.yml
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Дефолтный таймер вопроса (секунды)
DEFAULT_TIMER_SEC=30

# --- Mini App (веб-планер + статистика) ---
# Встроенный aiohttp-сервер слушает localhost; наружу — через SSH-туннель serveo
# (cloudflared блокируется DPI этой сети).
WEBAPP_ENABLED=true
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
# Статический публичный URL (если ставишь туннель вручную). Пусто → бот сам поднимет
# туннель (TUNNEL_ENABLED) и подставит URL автоматически.
WEBAPP_URL=
# Часовой пояс пользователя (UTC+5 для Узбекистана) — для группировки статистики по дням.
TZ_OFFSET_HOURS=5
# Для локального теста в обычном браузере (без Telegram) поставь свой user_id, иначе 0.
WEBAPP_DEV_USER_ID=0

# --- Встроенный SSH-туннель serveo (бот сам поднимает и обновляет кнопку меню) ---
TUNNEL_ENABLED=true
# Зарезервированный поддомен serveo → постоянный URL https://ИМЯ.serveo.net.
# Требует РАЗОВОЙ регистрации ключа /root/.ssh/serveo_ed25519.pub на console.serveo.net
# (бесплатный вход через Google/GitHub). Пусто → serveo выдаёт случайный URL каждый раз.
TUNNEL_SUBDOMAIN=
SERVEO_KEY=/root/.ssh/serveo_ed25519
